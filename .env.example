# Copy to .env and fill in. Never commit .env.
# Hugging Face token with "read" access, after accepting the LTX-2.5 licence on the model page (docs/00-before-you-start.md).
HF_TOKEN=
# From the RunPod "Connect" panel of your running pod, "SSH over exposed TCP" (docs/03-train-on-runpod.md, step 5).
POD_IP=
POD_PORT=
# Folder where you installed the LTX-2 MLX port for rendering on a Mac (docs/04-render.md, step 1).
LTX_MLX_DIR=
